# Kafka acessado pelos processos Python no host
KAFKA_BOOTSTRAP_SERVERS=localhost:19090,localhost:19091,localhost:19092
KAFKA_GROUP_ID=estoque-redis-dashboard-v1

# Redis usado como estado de leitura do dashboard
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Tópicos CDC
CDC_TOPIC_PREFIX=estoque
REABASTECIMENTO_TOPIC=reabastecimento

# Regras de reabastecimento
ESTOQUE_MINIMO=20
QUANTIDADE_REABASTECIMENTO=100
REABASTECIMENTO_COOLDOWN_SEGUNDOS=300

# Dashboard e retenção local
DASHBOARD_REFRESH_SECONDS=2
MOVEMENT_HISTORY_LIMIT=500
