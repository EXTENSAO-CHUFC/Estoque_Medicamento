{
  "name": "debezium-postgres-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "plugin.name": "pgoutput",
    "database.host": "host.docker.internal",
    "database.port": "5433",
    "database.user": "debezium_replicator",
    "database.password": "debezium_password",
    "database.dbname": "postgres",
    "database.server.name": "estoque_server",
    "table.include.list": "public.medicamentos,public.lotes,public.movimentacoes,public.fornecedores,public.almoxarifados,public.usuarios",
    "slot.name": "debezium_slot",
    "publication.autocreate.mode": "filtered",
    "publication.name": "debezium_pub"
  }
}
