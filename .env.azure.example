# AVISO: valores para comunicação interna entre containers na Azure.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=estoque-redis-dashboard-v1
CDC_TOPIC_PREFIX=estoque
REABASTECIMENTO_TOPIC=reabastecimento

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

ESTOQUE_MINIMO=20
QUANTIDADE_REABASTECIMENTO=100
REABASTECIMENTO_COOLDOWN_SEGUNDOS=300
DASHBOARD_REFRESH_SECONDS=5
MOVEMENT_HISTORY_LIMIT=500

KAFKA_CONNECT_URL=http://connect:8083
OLTP_HOST=postgres
OLTP_PORT=5432
OLTP_USER=debezium_replicator
OLTP_PASSWORD=debezium_password
OLTP_DATABASE=estoque_banco
